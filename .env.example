LLM_PROVIDER=doubao

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260215

# Optional D7 scene renderer. Gameplay remains available when unset.
IMAGE_PROVIDER=doubao
ARK_IMAGE_MODEL=
ARK_IMAGE_SIZE=1024x1024
ARK_IMAGE_TIMEOUT=120

# Local PostgreSQL application connection. Replace YOUR_PASSWORD locally only.
DATABASE_URL=postgresql+psycopg://dragon_world_app:YOUR_PASSWORD@localhost:5432/dragon_world
