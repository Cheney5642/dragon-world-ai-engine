# Secrets and local provider configuration
.env

# Local Python environment and bytecode
.venv/
__pycache__/
*.py[cod]

# Runtime Persistent World State and interrupted atomic-write files
data/saves/current_world.json
data/saves/npc_memories.json
data/saves/npc_relationships.json
data/saves/*.tmp

# Local development Interaction Event exports (not a Persistent Event Log)
data/runtime/

# Local Microsoft Office lock files
~$*.xlsx

# Frontend-only local configuration
frontend/.env.local
