{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity_grounding.schema.json",
  "title": "Identity Grounding Result v0.2",
  "description": "Deterministic, read-only classification of candidate identity into accepted facts and unverified claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_facts",
    "unverified_claims",
    "accepted_identity_facets",
    "accepted_traits",
    "accepted_capability_hints",
    "grounding_notes"
  ],
  "properties": {
    "accepted_facts": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unverified_claims": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accepted_identity_facets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrative_species",
        "occupations"
      ],
      "properties": {
        "narrative_species": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80
        },
        "occupations": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "description": "Grounding-approved narrative species and occupations safe for identity display."
    },
    "accepted_traits": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accepted_capability_hints": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "grounding_notes": {
      "type": "array",
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
